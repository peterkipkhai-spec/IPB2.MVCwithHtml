<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Slice Shoes</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">S</span>
                <span>Slice Shoes</span>
            </a>
            <div class="nav-links">
                <a asp-controller="Home" asp-action="Index" asp-fragment="collection">Collection</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="order">Order</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>&copy; @DateTime.Now.Year Slice Shoes. Walk bold. Move smart.</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
